{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    
    /* Declaration Settings */
    "declaration": true,
    "emitDeclarationOnly": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"],
      "@lakes/*": ["./src/database/lakes/*"]
    }
  },
  "include": ["index.ts"],
  "exclude": ["node_modules"]
}

